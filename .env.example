# ─────────────────────────────────────────────────
# SplitSquare Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────

# ── PostgreSQL connection ──────────────────────────────────────────────────────
# Use a full connection URL (works with Neon, Supabase, Railway, local Postgres).
# For Neon: copy the "Pooled connection" URL from your Neon dashboard.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a long random string in production: `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_secret

# ── Express server ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
